{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev (application)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/application"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "npm: production (application)",
      "type": "shell",
      "command": "npm run production",
      "options": {
        "cwd": "${workspaceFolder}/application"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
